# ---------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env itself.
# Everything here runs at zero cost in development.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- brand -----------------------------------------------------
BRAND_NAME=Kindred
LAUNCH_CITY=Bengaluru
SUPPORT_EMAIL=support@kindred.example
GRIEVANCE_EMAIL=grievance@kindred.example

# ---- database (local MySQL: XAMPP, Docker or MySQL Community) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kindred
DB_USER=root
DB_PASSWORD=
# "sqlite" runs the whole app on a file, with no MySQL to install.
# Use it only to try things out — distance search needs MySQL.
DB_DIALECT=mysql

# ---- auth ------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---- email and OTP ---------------------------------------------
# Leave MAIL_TRANSPORT=console in development: OTPs print to the
# terminal and no account is needed anywhere.
MAIL_TRANSPORT=console
MAIL_FROM="Kindred <no-reply@kindred.example>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- uploads ---------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- money (every amount is stored in paise) -------------------
DEFAULT_COMMISSION_PCT=18
DEFAULT_GST_PCT=18
MIN_PRICE_PER_HOUR=50000
MAX_PRICE_PER_HOUR=1000000

# ---- payments --------------------------------------------------
# "mock" needs no account and runs the whole flow locally.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=






