{
  "name": "kindred-server",
  "version": "1.0.0",
  "private": true,
  "description": "Just Rent a Friend — paid connection platform. Express + Sequelize + MySQL.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/seed/migrate.js",
    "db:seed": "node src/seed/seed.js",
    "db:reset": "node src/seed/migrate.js --force && node src/seed/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "sequelize": "^6.37.3",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "sqlite3@5.1.7": true
  }
}
